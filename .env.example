# =============================================================================
# Team Platform — Backend environment
# Copy to .env (development) or set real environment variables (production).
# Never commit real values. Use different secrets for development and production.
# =============================================================================

# development | production | test
NODE_ENV=development
PORT=4000

# --- Database (MySQL 8+ / MariaDB 10.4+) -------------------------------------
# Driver options can be appended as query params, e.g. ?ssl=true
# MySQL 8 without TLS may need: ?allowPublicKeyRetrieval=true
# Local XAMPP (root, empty password): mysql://root:@127.0.0.1:3306/team_platform
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
DB_CONNECTION_LIMIT=10

# --- Authentication -----------------------------------------------------------
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime (s, m, h, d)
JWT_EXPIRES_IN=15m
# Refresh token lifetime (rotated on every use)
REFRESH_TOKEN_EXPIRES_IN=7d

# --- HTTP ---------------------------------------------------------------------
# Browser origins allowed to call the API (the public website). Comma-separated, no "*".
CORS_ORIGINS=https://example.com,https://admin.example.com
# Express trust proxy: false | true | hop count | comma-separated IPs/subnets (e.g. loopback)
# Required behind Nginx / a load balancer so rate limiting sees real client IPs.
TRUST_PROXY=false
# Swagger UI at /api/docs (defaults to true outside production)
SWAGGER_ENABLED=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Rate limiting (global default, per IP) ----------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# --- File storage ------------------------------------------------------------
# Only "local" is implemented; see docs/storage.md to add S3 / R2.
STORAGE_DRIVER=local
# Directory for uploaded files (relative to the backend folder or absolute)
STORAGE_LOCAL_DIR=uploads
# Public URL under which files are served (this API's public URL + /uploads)
STORAGE_PUBLIC_URL=https://api.example.com/uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# --- Website revalidation (optional but recommended) -------------------------
# When set, the website regenerates affected pages immediately after admin edits.
FRONTEND_REVALIDATE_URL=https://example.com/api/revalidate
# Same value as REVALIDATE_SECRET in the frontend. At least 32 characters.
REVALIDATE_SECRET=

# --- Seed (used only by `npm run db:seed`) -----------------------------------
SEED_ADMIN_EMAIL=
# At least 12 characters. Change it after the first login.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

# --- Production start script (optional) --------------------------------------
# SKIP_MIGRATIONS=true   # when migrations run in CI/CD instead of on start
# DB_WAIT_ATTEMPTS=30
# DB_WAIT_DELAY_MS=2000
