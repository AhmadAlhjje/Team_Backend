# Copy to .env.test for `npm run test:e2e`.
# A dedicated, disposable database: migrations are applied before the run and
# every test suite empties the tables it uses. The database name must contain "test".
# Local XAMPP (root, empty password): create team_platform_test in phpMyAdmin first.
TEST_DATABASE_URL="mysql://root:@127.0.0.1:3306/team_platform_test"
