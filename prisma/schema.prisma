// =============================================================================
// Team Platform — database schema (MySQL 8 / MariaDB 10.4+)
//
// Rules (see ROLE.md → "Database rules"):
// - Every schema change goes through a migration (`npm run db:migrate`).
// - Never edit an applied migration; add a new one.
// - Content is hidden with `status` (DRAFT / ARCHIVED) instead of being deleted.
// - Relations that would orphan public content use `onDelete: Restrict`.
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Admin roles. Permissions per role live in src/common/auth/permissions.ts.
enum Role {
  SUPER_ADMIN
  ADMIN
}

/// Publication state shared by all public content.
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Lifecycle of a project (shown on the website).
enum ProjectPhase {
  IN_PROGRESS
  LIVE
  COMPLETED
}

enum AchievementType {
  COMPETITION
  AWARD
  CERTIFICATION
  MILESTONE
  OTHER
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

enum SocialPlatform {
  WEBSITE
  GITHUB
  LINKEDIN
  X
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  BEHANCE
  DRIBBBLE
  TELEGRAM
  WHATSAPP
  OTHER
}

// -----------------------------------------------------------------------------
// Auth
// -----------------------------------------------------------------------------

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(191)
  name              String    @db.VarChar(120)
  passwordHash      String    @db.VarChar(255)
  role              Role      @default(ADMIN)
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

/// Opaque refresh tokens (only the SHA-256 hash is stored).
/// Tokens are rotated on every refresh; reusing a rotated token revokes its whole family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    Int
  familyId  String    @db.VarChar(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?   @db.VarChar(255)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// Team
// -----------------------------------------------------------------------------

model TeamMember {
  id             Int           @id @default(autoincrement())
  slug           String        @unique @db.VarChar(120)
  name           String        @db.VarChar(120)
  role           String        @db.VarChar(120)
  specialization String?       @db.VarChar(191)
  bio            String?       @db.Text
  avatarUrl      String?       @db.VarChar(500)
  status         ContentStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  skills      TeamMemberSkill[]
  socialLinks SocialLink[]
  projects    ProjectMember[]

  @@index([status, sortOrder])
  @@map("team_members")
}

model TeamMemberSkill {
  id           Int    @id @default(autoincrement())
  teamMemberId Int
  name         String @db.VarChar(80)
  sortOrder    Int    @default(0)

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, name])
  @@map("team_member_skills")
}

/// Social links for a team member, or for the site itself when `teamMemberId` is null.
model SocialLink {
  id           Int            @id @default(autoincrement())
  platform     SocialPlatform
  url          String         @db.VarChar(500)
  label        String?        @db.VarChar(80)
  sortOrder    Int            @default(0)
  teamMemberId Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@index([teamMemberId, sortOrder])
  @@map("social_links")
}

// -----------------------------------------------------------------------------
// Services & technologies
// -----------------------------------------------------------------------------

/// Shared technology catalogue (React, NestJS, Flutter, ...). Created on demand from admin tag inputs.
model Technology {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())

  projects ProjectTechnology[]
  services ServiceTechnology[]

  @@map("technologies")
}

model Service {
  id          Int           @id @default(autoincrement())
  slug        String        @unique @db.VarChar(120)
  title       String        @db.VarChar(150)
  summary     String        @db.VarChar(400)
  description String?       @db.Text
  /// Key of a built-in icon (see frontend components/services/service-icon.tsx).
  icon        String        @default("custom") @db.VarChar(40)
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  technologies ServiceTechnology[]
  projects     ProjectService[]

  @@index([status, sortOrder])
  @@map("services")
}

model ServiceTechnology {
  serviceId    Int
  technologyId Int
  sortOrder    Int @default(0)

  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([serviceId, technologyId])
  @@index([technologyId])
  @@map("service_technologies")
}

// -----------------------------------------------------------------------------
// Clients
// -----------------------------------------------------------------------------

model Client {
  id                Int           @id @default(autoincrement())
  name              String        @db.VarChar(150)
  logoUrl           String?       @db.VarChar(500)
  websiteUrl        String?       @db.VarChar(500)
  industry          String?       @db.VarChar(120)
  description       String?       @db.Text
  /// The client agreed to be shown publicly. Required before publishing.
  hasDisplayConsent Boolean       @default(false)
  status            ContentStatus @default(DRAFT)
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  projects Project[]

  @@index([status, sortOrder])
  @@map("clients")
}

// -----------------------------------------------------------------------------
// Projects
// -----------------------------------------------------------------------------

model Project {
  id             Int           @id @default(autoincrement())
  slug           String        @unique @db.VarChar(160)
  title          String        @db.VarChar(160)
  summary        String        @db.VarChar(400)
  description    String?       @db.Text
  problem        String?       @db.Text
  solution       String?       @db.Text
  ourRole        String?       @db.Text
  results        String?       @db.Text
  /// Short label shown on cards, e.g. "تطبيق موبايل".
  category       String?       @db.VarChar(100)
  coverImageUrl  String?       @db.VarChar(500)
  liveUrl        String?       @db.VarChar(500)
  repositoryUrl  String?       @db.VarChar(500)
  startDate      DateTime?     @db.Date
  endDate        DateTime?     @db.Date
  phase          ProjectPhase  @default(COMPLETED)
  status         ContentStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  sortOrder      Int           @default(0)
  seoTitle       String?       @db.VarChar(120)
  seoDescription String?       @db.VarChar(200)
  ogImageUrl     String?       @db.VarChar(500)
  publishedAt    DateTime?
  clientId       Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client       Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  images       ProjectImage[]
  features     ProjectFeature[]
  technologies ProjectTechnology[]
  members      ProjectMember[]
  services     ProjectService[]
  testimonials Testimonial[]
  achievements Achievement[]

  @@index([status, isFeatured, sortOrder])
  @@index([status, sortOrder])
  @@index([clientId])
  @@map("projects")
}

model ProjectImage {
  id        Int      @id @default(autoincrement())
  projectId Int
  url       String   @db.VarChar(500)
  alt       String?  @db.VarChar(200)
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_images")
}

model ProjectFeature {
  id          Int     @id @default(autoincrement())
  projectId   Int
  title       String  @db.VarChar(200)
  description String? @db.VarChar(500)
  sortOrder   Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_features")
}

model ProjectTechnology {
  projectId    Int
  technologyId Int
  sortOrder    Int @default(0)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
  @@map("project_technologies")
}

/// A team member's participation in a project. Deleting a member who has
/// projects is blocked (Restrict) — archive the member instead.
model ProjectMember {
  projectId    Int
  teamMemberId Int
  /// Contribution in this project, e.g. "Backend & API".
  role         String? @db.VarChar(120)
  sortOrder    Int     @default(0)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Restrict)

  @@id([projectId, teamMemberId])
  @@index([teamMemberId])
  @@map("project_members")
}

model ProjectService {
  projectId Int
  serviceId Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
  @@index([serviceId])
  @@map("project_services")
}

// -----------------------------------------------------------------------------
// Achievements, testimonials, FAQ
// -----------------------------------------------------------------------------

model Achievement {
  id          Int             @id @default(autoincrement())
  title       String          @db.VarChar(200)
  description String?         @db.Text
  type        AchievementType @default(OTHER)
  /// Organizer or issuing body, e.g. the competition name.
  issuer      String?         @db.VarChar(150)
  /// Short highlight such as a rank, e.g. "المركز الأول".
  highlight   String?         @db.VarChar(120)
  date        DateTime?       @db.Date
  imageUrl    String?         @db.VarChar(500)
  /// Public proof (certificate, announcement, article).
  proofUrl    String?         @db.VarChar(500)
  projectId   Int?
  status      ContentStatus   @default(DRAFT)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
  @@index([projectId])
  @@map("achievements")
}

model Testimonial {
  id                Int           @id @default(autoincrement())
  authorName        String        @db.VarChar(120)
  authorTitle       String?       @db.VarChar(120)
  company           String?       @db.VarChar(150)
  content           String        @db.Text
  avatarUrl         String?       @db.VarChar(500)
  /// The client agreed to publish this testimonial. Required before publishing.
  hasDisplayConsent Boolean       @default(false)
  projectId         Int?
  status            ContentStatus @default(DRAFT)
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, sortOrder])
  @@index([projectId])
  @@map("testimonials")
}

model Faq {
  id        Int           @id @default(autoincrement())
  question  String        @db.VarChar(300)
  answer    String        @db.Text
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
  @@map("faqs")
}

// -----------------------------------------------------------------------------
// Contact
// -----------------------------------------------------------------------------

model ContactMessage {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(120)
  email       String        @db.VarChar(191)
  phone       String?       @db.VarChar(40)
  company     String?       @db.VarChar(150)
  projectType String?       @db.VarChar(120)
  budget      String?       @db.VarChar(80)
  message     String        @db.Text
  status      MessageStatus @default(UNREAD)
  /// SHA-256 of the sender IP (salted). Used for abuse investigation, never the raw IP.
  ipHash      String?       @db.Char(64)
  userAgent   String?       @db.VarChar(255)
  readAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("contact_messages")
}

// -----------------------------------------------------------------------------
// Site settings (single row, id = 1)
// -----------------------------------------------------------------------------

model SiteSetting {
  id                Int      @id @default(1)
  siteName          String   @db.VarChar(120)
  tagline           String?  @db.VarChar(200)
  /// Default meta description for the website.
  description       String?  @db.VarChar(500)
  logoUrl           String?  @db.VarChar(500)
  email             String?  @db.VarChar(191)
  phone             String?  @db.VarChar(40)
  whatsapp          String?  @db.VarChar(40)
  location          String?  @db.VarChar(200)
  heroTitle         String?  @db.VarChar(200)
  heroSubtitle      String?  @db.VarChar(500)
  aboutTitle        String?  @db.VarChar(200)
  /// Short "about" text for the homepage.
  aboutSummary      String?  @db.VarChar(1000)
  /// Full story for the /about page.
  aboutContent      String?  @db.Text
  ctaTitle          String?  @db.VarChar(200)
  ctaSubtitle       String?  @db.VarChar(500)
  /// Used to compute "years of experience". Leave empty to hide that statistic.
  foundedYear       Int?
  defaultOgImageUrl String?  @db.VarChar(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("site_settings")
}

/// "How we work" steps displayed on the website.
model ProcessStep {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(150)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("process_steps")
}
